{
  "name": "shipschematic-skills-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packs/*"
  ],
  "scripts": {
    "sync:bin": "node scripts/sync-bin.js",
    "pack:all": "npm pack --workspaces",
    "list": "node scripts/list.js",
    "validate": "npm pack --workspaces --dry-run",
    "bootstrap:npm": "node scripts/bootstrap-npm.mjs",
    "verify:npm": "node scripts/verify-npm-release.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
