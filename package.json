{
  "name": "shipschematic-skills-public",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packs/*"
  ],
  "scripts": {
    "sync:bin": "node scripts/sync-bin.js",
    "pack:all": "npm pack --workspaces",
    "list": "node scripts/list.js",
    "check": "npm pack --workspaces --dry-run",
    "validate": "npm run check",
    "build:artifacts": "node scripts/build-artifacts.mjs",
    "verify:npm": "node scripts/verify-npm-release.mjs",
    "post-release": "node scripts/post-release.mjs",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "node scripts/publish-artifacts.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7"
  }
}
